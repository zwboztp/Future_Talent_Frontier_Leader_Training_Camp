<!doctype html>
  import { createClient } from "https://cdn.jsdelivr.net/npm/@supabase/supabase-js/+esm";

  const SUPABASE_URL = "여기에_프로젝트_URL";
  const SUPABASE_ANON_KEY = "여기에_anon_key";

  const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

  const leaderboardPanel = document.getElementById("leaderboardPanel");
  const leaderboardList = document.getElementById("leaderboardList");
  const leaderboardBlock = document.getElementById("leaderboardBlock");
  const gameOverOverlay = document.getElementById("gameOverOverlay");
  const playerNameInput = document.getElementById("playerNameInput");
  const submitScoreBtn = document.getElementById("submitScoreBtn");
  const closeLeaderboardBtn = document.getElementById("closeLeaderboardBtn");
  const leaderboardToggleBtn = document.getElementById("leaderboardToggleBtn");
  const gameOverScoreText = document.getElementById("gameOverScoreText");

  let leaderboardVisible = false;
  let currentScore = 0;
  let canSubmitScore = false;

  const bannedWords = [
    "sex", "porn", "nude", "naked", "fuck", "shit", "bitch", "damn",
    "hitler", "nazi", "trump", "biden", "kim", "north korea",
    "윤어게인", "부정선거", "이재명", "노무현", "X스", "야스", "섹스", "새끼", "자위", "씨발", "시발", "X발", "X끼", "병신", "찢재명", "자지", "보지"
  ];

  function isCleanName(name) {
    const cleaned = name.trim();
    if (!cleaned) return false;
    if (cleaned.length > 20) return false;
    const lower = cleaned.toLowerCase();
    return !bannedWords.some(word => lower.includes(word.toLowerCase()));
  }

  async function loadLeaderboard() {
    const { data, error } = await supabase
      .from("leaderboard")
      .select("name, score, created_at")
      .order("score", { ascending: false })
      .limit(10);

    if (error) {
      leaderboardList.innerHTML = `<li>리더보드를 불러오지 못했어요.</li>`;
      return;
    }

    leaderboardList.innerHTML = "";
    data.forEach((row, index) => {
      const li = document.createElement("li");
      li.textContent = `${index + 1}. ${row.name} - ${row.score}`;
      leaderboardList.appendChild(li);
    });
  }

  function showLeaderboard() {
    leaderboardVisible = true;
    leaderboardPanel.style.display = "block";
    loadLeaderboard();
  }

  function hideLeaderboard() {
    leaderboardVisible = false;
    leaderboardPanel.style.display = "none";
  }

  leaderboardBlock.addEventListener("click", () => {
    showLeaderboard();
  });

  leaderboardToggleBtn.addEventListener("click", () => {
    if (leaderboardVisible) hideLeaderboard();
    else showLeaderboard();
  });

  closeLeaderboardBtn.addEventListener("click", hideLeaderboard);

  async function submitLeaderboardScore() {
    const name = playerNameInput.value.trim();

    if (!canSubmitScore) return;
    if (!isCleanName(name)) {
      alert("이름은 20글자 이하이고, 금지된 단어를 포함하면 안 돼요.");
      return;
    }

    submitScoreBtn.disabled = true;

    const { error } = await supabase
      .from("leaderboard")
      .insert({
        name,
        score: currentScore
      })
      .select();

    submitScoreBtn.disabled = false;

    if (error) {
      alert("점수 저장에 실패했어요.");
      return;
    }

    canSubmitScore = false;
    gameOverOverlay.style.display = "none";
    loadLeaderboard();
    showLeaderboard();
  }

  submitScoreBtn.addEventListener("click", submitLeaderboardScore);

  function openGameOver(score) {
    currentScore = score;
    canSubmitScore = true;
    gameOverScoreText.textContent = `점수: ${score}`;
    playerNameInput.value = "";
    gameOverOverlay.style.display = "flex";
    leaderboardPanel.style.display = "none";
  }

  window.openGameOver = openGameOver;
  window.showLeaderboard = showLeaderboard;
</script>
